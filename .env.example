# ==========================================
# Variaveis de Ambiente - API Auth (Porta 8083)
# ==========================================
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA envie o arquivo .env com credenciais reais para o Git!

# Segredo de Assinatura JWT (minimo 256 bits / 32 caracteres)
JWT_SECRET=seu_segredo_jwt_super_secreto_aqui

# Banco de Dados PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=1234
JPA_DDL=update

# Mercado Pago (Access Token do painel de desenvolvedor)
MP_ACCESS_TOKEN=seu_access_token_mercado_pago_aqui
